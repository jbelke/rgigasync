# Copy to .env in the directory you run rgigasync from. Every value here is a
# default; the equivalent command-line flag always wins.
#
# .env is read from the current working directory, not from the source tree.

### Parallelism -------------------------------------------------------------
# Concurrent rsync processes used by --parallel. 0 means one per core.
# Equivalent flag: --jobs
RGIGASYNC_NUM_THREADS=0

### Progress ----------------------------------------------------------------
# Print a scan progress line every N entries. 0 disables it.
RGIGASYNC_FILE_FEEDBACK_COUNT=1000000

# Print a scan progress line at least this often, in seconds. 0 disables it.
RGIGASYNC_TIME_FEEDBACK_INTERVAL=120

### rsync -------------------------------------------------------------------
# Which rsync to run. Worth setting on macOS, where /usr/bin/rsync is openrsync
# and cannot carry extended attributes or ACLs no matter which flags you pass.
# RGIGASYNC_RSYNC=/opt/homebrew/bin/rsync

# Attempts per batch, including the first. Equivalent flag: --retries
RGIGASYNC_RETRIES=5

# Seconds between attempts. Equivalent flag: --retry-delay
RGIGASYNC_RETRY_DELAY_SECS=90

### Legacy names ------------------------------------------------------------
# Still honoured, but the RGIGASYNC_-prefixed names above take precedence:
#   RAYON_NUM_THREADS, FILE_FEEDBACK_COUNT, TIME_FEEDBACK_INTERVAL
